# Configuration pour la migration de production
# Copiez ce fichier en .env.migration et remplissez avec vos vraies credentials

# Base de données source (production - exemple: Render, AWS RDS, etc.)
SOURCE_DB_HOST="your-production-host.com"
SOURCE_DB_PORT="5432"
SOURCE_DB_NAME="your_production_db_name"
SOURCE_DB_USER="your_production_user"
SOURCE_DB_PASSWORD="your_production_password"

# Base de données cible (locale)
TARGET_DB_HOST="localhost"
TARGET_DB_PORT="5432"
TARGET_DB_NAME="space_db"
TARGET_DB_USER="user"
TARGET_DB_PASSWORD="password"
